<?xml version="1.0" encoding="UTF-8"?>

<configuration>
<system.webServer>
<handlers>
<add name="httpPlatformHandler" path="" verb="" modules="httpPlatformHandler" resourceType="Unspecified" />
</handlers>
<!--
HttpPlatformHandler settings:
- processPath: ABSOLUTE path to the python.exe inside your project's venv.
- arguments: The startup shim (app.py) which loads .env and launches uvicorn.
- stdoutLogEnabled: Set to "true" during debugging to see print statements and errors.
- stdoutLogFile: Path to the log file. "." means the project root.
- startupTimeLimit: Time in seconds IIS waits for the app to start. ML apps can be slow to load, so this is increased.
-->
<httpPlatform processPath="C:\inetpub\wwwroot\face-recognition-api\venv\Scripts\python.exe"
              arguments="app.py"
              stdoutLogEnabled="true"
              stdoutLogFile=".\python_logs.log"
              startupTimeLimit="120">
  <environmentVariables>
    <!--
    PYTHONPATH: ABSOLUTE path to your project's root folder.
    This helps Python find your modules (like the app/ package).
    -->
    <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\face-recognition-api" />
    <!--
    Dataiku Model API settings.
    .env is NOT deployed (it is git-ignored), so these MUST be set here.
    DATAIKU_VERIFY_SSL=false is required because the Dataiku host presents a
    self-signed / internal-CA certificate (rtatestdom.local).
    -->
    <environmentVariable name="DATAIKU_MODEL_API_URL" value="https://rtauevaidss1.rtatestdom.local:13000" />
    <environmentVariable name="DATAIKU_VERIFY_SSL" value="false" />
    <environmentVariable name="DATAIKU_TIMEOUT_SECONDS" value="300" />
  </environmentVariables>
</httpPlatform>
</system.webServer>
</configuration>